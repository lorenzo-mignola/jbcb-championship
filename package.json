{
  "name": "jbcb-championship",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*",
    "#tests/*": "./tests/*"
  },
  "engines": {
    "node": "26",
    "pnpm": "10"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:env": "envsec -c jbcb-championship run -i 'vite dev'",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test": "vitest --coverage"
  },
  "dependencies": {
    "@svelte-put/shortcut": "^4.2.0",
    "better-auth": "^1.7.14",
    "better-auth-firestore": "^1.3.3",
    "firebase-admin": "^14.5.0",
    "immer": "^11.2.9",
    "ky": "^2.2.0",
    "nanoid": "^6.0.2",
    "ramda": "^0.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "@sveltejs/adapter-vercel": "^7.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/ramda": "^0.32.0",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-devtools-json": "^1.1.2",
    "vitest": "^5.0.5"
  }
}
