{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "paths": {
      "#lib/*": ["./src/lib/*"],
      "#routes/*": ["./src/routes/*"],
      "#tests/*": ["./tests/*"]
    },
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "sourceMap": true
  },
  "include": [
    "src",
    "tests",
    "*"
  ],
  "exclude": [
    "coverage",
    "node_modules"
  ]
}
